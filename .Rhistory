) %>%
select(
Code_Branche,
annee,
trimestre,
P1_vpap = P1_vpap_agg,
P1_crt  = P1_crt_agg,
P2_vpap = P2_vpap_cal,
P2_crt  = P2_crt_cal,
B1_vpap,
B1_crt
) %>%
arrange(Code_Branche, annee, trimestre)
message("✅ Comptes Finalisés. Structure vérifiée :")
print(head(df_comptes_finaux))
poids_p1p2 <- res_trim$poids_trim
# =========================
# A) Production par produit
# =========================
p1_par_produit <- transformer_branche_produit(
df_branches   = p1_agreg,
poids_tbl     = poids_p1p2,
operation     = "P1",
value_crt_col = "P1_crt_agg",
value_vol_col = "P1_vpap_agg",
annee_col     = "annee",
trimestre_col = "trimestre",
branche_col   = "Code_Branche",
produit_col   = "Code_Produit",
normalize     = TRUE
)
# =========================
# B) CI par produit (P2)
# =========================
p2_par_produit <- transformer_branche_produit(
df_branches   = p2_final_cal,
poids_tbl     = poids_p1p2,
operation     = "P2",
value_crt_col = "P2_crt_cal",
value_vol_col = "P2_vpap_cal",
annee_col     = "annee",
trimestre_col = "trimestre",
branche_col   = "Code_Branche",
produit_col   = "Code_Produit",
normalize     = TRUE
)
# Export Excel enrichi (taux de croissance ajoutés automatiquement)
output_file <- file.path(root_dir, paste0("Resultats_CNT_", Sys.Date(), ".xlsx"))
export_results_excel(
list(
"Synthese_Comptes"  = df_comptes_finaux,
"Ind1_Crt"          = cnt_ind1_crt,
"Ind1_Ch"           = cnt_ind1_ch,
"Ind2_Crt"          = cnt_ind2_crt,
"Ind2_Ch"           = cnt_ind2_ch,
"Ind3_Ch"           = cnt_ind3_ch,
"Ind3_Crt"          = cnt_ind3_crt,
"Ind4_Crt"          = cnt_ind4_crt,
"Ind4_Ch"           = cnt_ind4_ch,
"Coeff_Techniques"  = res_trim$coef_tech_trim
),
file_name = output_file
)
View(prod_complete)
View(ind_crt)
View(prod_crt)
# ==============================================================================
knitr::opts_chunk$set(echo = TRUE, warning = FALSE, message = FALSE)
# Chargement des packages requis
library(QnaSut)      # Le package métier
library(dplyr)       # Manipulation de données
library(tidyr)       # (Pour pivot_wider)
library(readxl)      # Lecture Excel
library(knitr)       # Pour les tableaux
library(rjd3bench)   # Pour le lissage rapide
# ==============================================================================
# CONFIGURATION : lire config.yml (adapter uniquement config.yml à votre poste)
# ==============================================================================
cfg <- load_config()   # Cherche config.yml dans le répertoire courant
root_dir                 <- cfg$root_dir
data_hist_dir            <- cfg$data_hist_dir
nomen_dir                <- cfg$nomen_dir
derniere_annee_definitif <- cfg$derniere_annee_definitif
annee_fin_projection     <- cfg$annee_fin_projection
# Chemins des fichiers Excel sources (construits automatiquement)
path_ind  <- file.path(root_dir, "R_Indicateur.xlsx")
path_cna  <- file.path(root_dir, "R_CNA.xlsx")
path_prix <- file.path(root_dir, "R_Prix.xlsx")
path_tre  <- file.path(root_dir, "R_Serie_TRE.xlsx")
message("📥 Chargement des données...")
# Helper : import avec message d’erreur clair
safe_import <- function(expr, label) {
tryCatch(expr, error = function(e) stop(sprintf("❌ Erreur import [%s] : %s", label, e$message)))
}
# 1.1 Indicateurs & CNA
ind_crt        <- safe_import(import_matrix_cnt(path_ind, "IndCrt"),  "IndCrt")
ind_cst        <- safe_import(import_matrix_cnt(path_ind, "IndCst"),  "IndCst")
prod_crt       <- safe_import(import_matrix_cnt(path_cna, "ProdCrt"), "ProdCrt")
prod_ch        <- safe_import(import_matrix_cnt(path_cna, "ProdCh"),  "ProdCh")
ci_crt         <- safe_import(import_matrix_cnt(path_cna, "CiCrt"),   "CiCrt")
ci_vol         <- safe_import(import_matrix_cnt(path_cna, "CiVol"),   "CiVol")
ci_ch          <- safe_import(import_matrix_cnt(path_cna, "CiCh"),    "CiCh")
ind_ce_struct  <- safe_import(import_ind_ce_structured(path_ind, "IndCE"),     "IndCE")
cna_ere_struct <- safe_import(import_cna_ere_structured(path_cna, "CnaEre"),   "CnaEre")
# 1.2 Import Prix
prix_etal <- safe_import(import_matrix_prix(path_prix, "Prix_Etal") |> prepare_price_data(), "Prix_Etal")
prix_niv3 <- safe_import(import_prix_niv3(path_prix), "Prix_Niv3")
# 1.3 Historique TRE (Niveau 2)
path_db_tre <- file.path(data_hist_dir, "Base_TRE_Historique.rds")
if (!file.exists(path_db_tre)) stop("❌ Base TRE introuvable : ", path_db_tre)
db_tre <- safe_import(readRDS(path_db_tre), "Base_TRE_Historique.rds")
# 1.4 Agrégation TRE vers Étalonnage
path_passage <- file.path(data_hist_dir, "Table_Passage_Niv2_Etal.rds")
if (!file.exists(path_passage)) stop("❌ Table de passage introuvable. Lancez 00_creation_table_passage.R")
table_passage <- safe_import(readRDS(path_passage), "Table_Passage_Niv2_Etal.rds")
# Agrégation immédiate vers la nomenclature d’étalonnage
db_tre_etal <- agreger_tre_etalonnage(db_tre, table_passage)
rm(db_tre)   # Libération mémoire : db_tre (~880k lignes) non utilisé après agrégation
# Chargement tables structurelles (nomenclatures)
Map_Branches <- safe_import(readRDS(file.path(nomen_dir, "Map_Branches.rds")), "Map_Branches.rds")
Map_Produits <- safe_import(readRDS(file.path(nomen_dir, "Map_Produits.rds")), "Map_Produits.rds")
message("✅ Toutes les données importées avec succès.")
message("🚀 Démarrage du module TRE...")
# 1. Calcul des Ratios Annuels Historiques (Poids & CT sur base agrégée)
ratios_annuels <- calculer_ratios_annuels_etal(db_tre_etal)
# 2. Bornes temporelles lues depuis config.yml
# (derniere_annee_definitif et annee_fin_projection sont déjà définis en 0.1)
# 3. Trimestrialisation Complète
# (Projection récursive des volumes + Lissage + Calcul des prix branches)
res_trim <- trimestrialiser_cnt_complet(
ratios_annuels = ratios_annuels,
df_prix_niv3 = prix_niv3,
derniere_annee_cna = derniere_annee_definitif,
annee_fin_proj = annee_fin_projection
)
# 4. Extraction pour le benchmarking (ct_trim contient déjà Coef_Technique)
res_trim$coef_tech_trim <- res_trim$ct_trim
message("✅ Ratios trimestriels calculés et disponibles.")
## 1.1. Benchmarking des Indicateurs (Initial)
message("--- Benchmarking groupe 1 (Direct) ---")
cnt_ind1_crt <- benchmark_groupe(ind_crt, prod_crt, "Ind1", "valeur")
cnt_ind1_ch <- benchmark_groupe(ind_cst, prod_ch, "Ind1", "valeur")
cnt_ind2_crt <- benchmark_groupe(ind_crt, prod_crt, "Ind2", "valeur")
cnt_ind3_ch <- benchmark_groupe(ind_cst, prod_ch, "Ind3", "valeur")
## 1.2. Déflation/Inflation
message("--- Application des Prix ---")
# Déflation Ind2 : On déflate la Valeur calée (cnt_ind2_crt)
est_ind2_vol <- apply_price_to_bench(
df_bench = cnt_ind2_crt,
df_prix = prix_etal,
operation = "deflate"
)
# Inflation Ind3 : On inflate le Volume calé (cnt_ind3_ch)
est_ind3_val <- apply_price_to_bench(
df_bench = cnt_ind3_ch,
df_prix = prix_etal,
operation = "inflate"
)
## 1.3. Benchmarking Final
message("--- Benchmarking groupe 2 ---")
cnt_ind2_ch <- benchmark_groupe(
df_source = est_ind2_vol,
df_target = prod_ch,
type_filter = "Ind2",
value_col = "valeur_estimee"
)
cnt_ind3_crt <- benchmark_groupe(
df_source = est_ind3_val,
df_target = prod_crt,
type_filter = "Ind3",
value_col = "valeur_estimee"
)
## 1.4. Préparation au Déchaînage (Consolidation)
message("📦 Consolidation des résultats P1...")
# 1. Regroupement de TOUTES les VALEURS COURANTES (_crt)
# On prend : Ind1 direct + Ind2 direct + Ind3 final
df_all_crt <- bind_rows(
cnt_ind1_crt %>% mutate(methode = "Ind1"),
cnt_ind2_crt %>% mutate(methode = "Ind2"),
cnt_ind3_crt %>% mutate(methode = "Ind3")
) %>%
select(full_code, annee, trimestre, valeur_crt = valeur_cal)
# 2. Regroupement de TOUS les VOLUMES CHAÎNÉS (_ch)
# On prend : Ind1 direct + Ind2 final + Ind3 direct
df_all_ch <- bind_rows(
cnt_ind1_ch %>% mutate(methode = "Ind1"),
cnt_ind2_ch %>% mutate(methode = "Ind2"),
cnt_ind3_ch %>% mutate(methode = "Ind3")
) %>%
select(full_code, annee, trimestre, valeur_ch = valeur_cal)
# 3. Fusion Unique (Merge)
prod_complete <- inner_join(
df_all_crt,
df_all_ch,
by = c("full_code", "annee", "trimestre")
)
# 4. Calcul du VPAP (Déchaînage)
prod_complete <- prod_complete %>%
group_by(full_code) %>%
mutate(valeur_vpap = dechainer_valeurs(valeur_crt, valeur_ch, trim = TRUE)) %>%
ungroup()
# ========================================================================
# 1.5.1 AGREGATION P1 : FUSION STRUCTURELLE
# ========================================================================
p1_agreg <- prod_complete %>%
mutate(Code_Branche = trimws(sub(".*\\*", "", full_code))) %>%
group_by(annee, trimestre, Code_Branche) %>%
summarise(
P1_crt_agg  = sum(valeur_crt, na.rm = TRUE),
P1_vpap_agg = sum(valeur_vpap, na.rm = TRUE),
.groups = "drop"
)
# ========================================================================
# 1.5.2 PRÉPARATION DES RATIOS ET CALCUL DES INDICATEURS P2
# ========================================================================
df_ratios_clean <- res_trim$coef_tech_trim %>%
mutate(
Code_Branche = trimws(as.character(Code_Branche)),
Annee = as.integer(Annee),
Trimestre = as.integer(Trimestre)
) %>%
select(Annee, Trimestre, Code_Branche, Type_Prix, Coef_Technique) %>%
filter(Type_Prix %in% c("Courant", "Constant")) %>%
pivot_wider(
names_from = Type_Prix,
values_from = Coef_Technique,
values_fill = 0
) %>%
rename(CT_Crt = Courant, CT_Vol = Constant)
df_calcul_p2 <- p1_agreg %>%
inner_join(df_ratios_clean, by = c("annee"="Annee", "trimestre"="Trimestre", "Code_Branche")) %>%
mutate(
Ind_P2_vpap = P1_vpap_agg * CT_Vol,
Ind_P2_crt  = P1_crt_agg * CT_Crt
)
# ========================================================================
# 1.5.3 CHAÎNAGE
# ========================================================================
est_p2_chained <- df_calcul_p2 %>%
arrange(Code_Branche, annee, trimestre) %>%
group_by(Code_Branche) %>%
mutate(P2_ch_est = calcul_valeur_chainee_trim(IndCrt = Ind_P2_crt, IndVol = Ind_P2_vpap)) %>%
ungroup()
# ========================================================================
# 1.5.4 BENCHMARKING (Calage sur Cibles Annuelles)
# ========================================================================
# A) Cibles annuelles (courant + volume VPAP)
ci_crt_agg <- ci_crt %>%
mutate(full_code = extract_branch_code(full_code)) %>%
group_by(annee, full_code) %>%
summarise(ci_crt_agg = sum(valeur, na.rm = TRUE), .groups = "drop")
ci_vol_agg <- ci_vol %>%
mutate(full_code = extract_branch_code(full_code)) %>%
group_by(annee, full_code) %>%
summarise(ci_vol_agg = sum(valeur, na.rm = TRUE), .groups = "drop")
# B) Table CI annuelle complète (courant + VPAP)
ci_bran <- ci_crt_agg %>%
inner_join(ci_vol_agg, by = c("annee", "full_code")) %>%
arrange(full_code, annee)
# C) Chaînage ANNUEL de la CI (on chaîne les volumes VPAP avec les courants)
ci_bran <- ci_bran %>%
group_by(full_code) %>%
mutate(ci_ch_agg = calcul_valeur_chainee_annuel(IndCrt = ci_crt_agg, IndVol = ci_vol_agg)) %>%
ungroup()
# D) Benchmarking P2 courant (source trimestrielle vs cible annuelle)
bench_p2_crt <- benchmark_groupe(
df_source = est_p2_chained %>% rename(valeur = Ind_P2_crt, full_code = Code_Branche),
df_target = ci_crt_agg %>% rename(valeur = ci_crt_agg),
type_filter = NULL,
value_col = "valeur"
) %>% rename(P2_crt_cal = valeur_cal)
# E) Benchmarking P2 volume chaîné (source trimestrielle vs cible annuelle chaînée)
bench_p2_ch <- benchmark_groupe(
df_source = est_p2_chained %>% rename(valeur = P2_ch_est, full_code = Code_Branche),
df_target = ci_bran %>% select(annee, full_code, valeur = ci_ch_agg),
type_filter = NULL,
value_col = "valeur"
) %>% rename(P2_ch_cal = valeur_cal)
# ========================================================================
# 1.5.5 CONSOLIDATION FINALE ET CALCUL DU SOLDE (B1)
# ========================================================================
p2_final_cal <- inner_join(
bench_p2_crt %>% select(annee, trimestre, Code_Branche = full_code, P2_crt_cal),
bench_p2_ch  %>% select(annee, trimestre, Code_Branche = full_code, P2_ch_cal),
by = c("annee", "trimestre", "Code_Branche")
) %>%
group_by(Code_Branche) %>%
mutate(
P2_vpap_cal = dechainer_valeurs(P2_crt_cal, P2_ch_cal, trim = TRUE)
) %>%
ungroup()
# 1. Désagrégation de la CI vers les produits niv3
p2_par_produit_n3 <- transformer_branche_produit(
df_branches   = p2_final_cal,
poids_tbl     = res_trim$poids_trim,
operation     = "P2",
value_crt_col = "P2_crt_cal",
value_vol_col = "P2_vpap_cal",
annee_col     = "annee",
trimestre_col = "trimestre",
branche_col   = "Code_Branche",
produit_col   = "Code_Produit",
normalize     = TRUE
)
# 2. Passage de la nomenclature produit niv3 vers la nomenclature étalonnage
p2_par_produit_etal <- p2_par_produit_n3 %>%
inner_join(
Map_Produits %>%
transmute(
Code_Produit   = trimws(as.character(Code_Prod_N3)),
Code_Prod_Etal = trimws(as.character(Code_Prod_Etal))
) %>%
distinct(),
by = "Code_Produit"
) %>%
group_by(annee, trimestre, Code_Prod_Etal) %>%
summarise(
valeur_crt = sum(valeur_crt, na.rm = TRUE),
valeur_vol = sum(valeur_vol, na.rm = TRUE),
.groups = "drop"
)
# 3. Produits cibles Ind4
produits_ind4 <- ind_crt %>%
filter(type_ind == "Ind4") %>%
mutate(Code_Prod_Etal = sub("^Ind4_TOTAL\\*", "", full_code)) %>%
distinct(Code_Prod_Etal) %>%
pull(Code_Prod_Etal)
# 4. Restriction aux produits Ind4
p2_par_produit_etal_ind4 <- p2_par_produit_etal %>%
filter(Code_Prod_Etal %in% produits_ind4)
# 5. Construction des séries trimestrielles Ind4 (courant, volume, chaîné estimé)
ind4_source_complete <- p2_par_produit_etal_ind4 %>%
transmute(
annee = annee,
trimestre = trimestre,
full_code = paste0("Ind4_TOTAL*", Code_Prod_Etal),
valeur_crt = valeur_crt,
valeur_vol = valeur_vol
) %>%
arrange(full_code, annee, trimestre) %>%
group_by(full_code) %>%
mutate(
valeur_ch = calcul_valeur_chainee_trim(
IndCrt = valeur_crt,
IndVol = valeur_vol
)
) %>%
ungroup()
# 6. Tables sources pour benchmarking
ind4_crt_source <- ind4_source_complete %>%
transmute(
annee = annee,
trimestre = trimestre,
periode = paste0(annee, "T", trimestre),
full_code = full_code,
valeur = valeur_crt,
branche_macro = sub("^Ind4_", "", full_code),
type_ind = "Ind4"
)
ind4_ch_source <- ind4_source_complete %>%
transmute(
annee = annee,
trimestre = trimestre,
periode = paste0(annee, "T", trimestre),
full_code = full_code,
valeur = valeur_ch,
branche_macro = sub("^Ind4_", "", full_code),
type_ind = "Ind4"
)
# 7. Benchmarking final
cnt_ind4_crt <- benchmark_groupe(
df_source = ind4_crt_source,
df_target = prod_crt,
type_filter = "Ind4",
value_col = "valeur"
)
cnt_ind4_ch <- benchmark_groupe(
df_source = ind4_ch_source,
df_target = prod_ch,
type_filter = "Ind4",
value_col = "valeur"
)
# 8. reconstitution VPAP benchmarké
ind4_final <- inner_join(
cnt_ind4_crt %>% select(annee, trimestre, full_code, valeur_crt_cal = valeur_cal),
cnt_ind4_ch  %>% select(annee, trimestre, full_code, valeur_ch_cal = valeur_cal),
by = c("annee", "trimestre", "full_code")
) %>%
group_by(full_code) %>%
mutate(
valeur_vpap_cal = dechainer_valeurs(valeur_crt_cal, valeur_ch_cal, trim = TRUE)
) %>%
ungroup()
df_comptes_finaux <- p1_agreg %>%
inner_join(p2_final_cal, by = c("annee", "trimestre", "Code_Branche")) %>%
mutate(
B1_crt  = P1_crt_agg - P2_crt_cal,
B1_vpap = P1_vpap_agg - P2_vpap_cal
) %>%
select(
Code_Branche,
annee,
trimestre,
P1_vpap = P1_vpap_agg,
P1_crt  = P1_crt_agg,
P2_vpap = P2_vpap_cal,
P2_crt  = P2_crt_cal,
B1_vpap,
B1_crt
) %>%
arrange(Code_Branche, annee, trimestre)
message("✅ Comptes Finalisés. Structure vérifiée :")
print(head(df_comptes_finaux))
poids_p1p2 <- res_trim$poids_trim
# =========================
# A) Production par produit
# =========================
p1_par_produit <- transformer_branche_produit(
df_branches   = p1_agreg,
poids_tbl     = poids_p1p2,
operation     = "P1",
value_crt_col = "P1_crt_agg",
value_vol_col = "P1_vpap_agg",
annee_col     = "annee",
trimestre_col = "trimestre",
branche_col   = "Code_Branche",
produit_col   = "Code_Produit",
normalize     = TRUE
)
# =========================
# B) CI par produit (P2)
# =========================
p2_par_produit <- transformer_branche_produit(
df_branches   = p2_final_cal,
poids_tbl     = poids_p1p2,
operation     = "P2",
value_crt_col = "P2_crt_cal",
value_vol_col = "P2_vpap_cal",
annee_col     = "annee",
trimestre_col = "trimestre",
branche_col   = "Code_Branche",
produit_col   = "Code_Produit",
normalize     = TRUE
)
# Export Excel enrichi (taux de croissance ajoutés automatiquement)
output_file <- file.path(root_dir, paste0("Resultats_CNT_", Sys.Date(), ".xlsx"))
export_results_excel(
list(
"Synthese_Comptes"  = df_comptes_finaux,
"Ind1_Crt"          = cnt_ind1_crt,
"Ind1_Ch"           = cnt_ind1_ch,
"Ind2_Crt"          = cnt_ind2_crt,
"Ind2_Ch"           = cnt_ind2_ch,
"Ind3_Ch"           = cnt_ind3_ch,
"Ind3_Crt"          = cnt_ind3_crt,
"Ind4_Crt"          = cnt_ind4_crt,
"Ind4_Ch"           = cnt_ind4_ch,
"Coeff_Techniques"  = res_trim$coef_tech_trim
),
file_name = output_file
)
devtools::check()
devtools::check()
devtools::check()
View(ind_ce_struct)
View(res_trim)
library(QnaSut)
