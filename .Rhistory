library(readxl)
library(dplyr)
library(stringdist)
install.packages("stringdist")
library(readxl)
library(dplyr)
library(stringdist)
library(writexl)
# Chemin du fichier
file_path <- "C:/CnaBfaScn08/CntBfaV3/PrTCD.xlsx"
# 1. Lire le fichier
df <- read_excel(file_path, sheet = "2024_2025")
# 2. Extraire les noms uniques
vendors <- unique(df$`25VENDEURS`)[!is.na(unique(df$`25VENDEURS`))]
# 3. Matrice de similarité (distance Jaro-Winkler)
mat <- stringdistmatrix(vendors, vendors, method = "jw", p = 0.1)
threshold <- 0.15  # seuil de regroupement
hc <- hclust(as.dist(mat), method = "average")
groups <- cutree(hc, h = threshold)
# 4. Créer un mapping : chaque groupe prend un nom canonique (le plus long)
group_names <- data.frame(
original = vendors,
group = groups,
stringsAsFactors = FALSE
)
mapping <- group_names %>%
group_by(group) %>%
mutate(
canonical = original[which.max(nchar(original))]
) %>%
ungroup() %>%
select(original, canonical) %>%
distinct()
# 5. Appliquer le mapping
df <- df %>%
left_join(mapping, by = c("25VENDEURS" = "original")) %>%
mutate(Vendeur_Nettoye = ifelse(is.na(canonical), `25VENDEURS`, canonical))
# 6. Sauvegarder le fichier nettoyé
output_path <- "C:/CnaBfaScn08/CntBfaV3/PrTCD_clean.xlsx"
write_xlsx(df, output_path)
print(paste("Fichier nettoyé enregistré sous :", output_path))
