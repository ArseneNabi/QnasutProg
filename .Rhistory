bilan_cna <- bilan_annuel |> filter(periode == "CNA")
cat("=== BLOC 1 : Années CNA (≤", annee_cna, ") — égalité annuelle ===\n")
cat("Lignes avec |solde| < 1 :", sum(abs(bilan_cna$solde) < 1), "/", nrow(bilan_cna), "\n")
cat("Lignes avec |solde| < 100 :", sum(abs(bilan_cna$solde) < 100), "/", nrow(bilan_cna), "\n\n")
cat("Déséquilibres résiduels (|solde_pct| > 0.5%) :\n")
bilan_cna |>
filter(abs(solde_pct) > 0.5) |>
arrange(desc(abs(solde_pct))) |>
select(Code_Produit, annee, res, emp, solde_pct) |>
print(n = 15)
# ── BLOC 2 : Années de projection ────────────────────────────────────────────
cat("\n=== BLOC 2 : Années de projection (>", annee_cna, ") — écarts attendus ===\n")
bilan_annuel |>
filter(periode == "Projection") |>
group_by(Code_Produit) |>
summarise(s_moy = round(mean(solde_pct), 1), s_max = round(max(abs(solde_pct)), 1),
.groups = "drop") |>
filter(abs(s_moy) > 5) |>
arrange(desc(abs(s_moy))) |>
print()
library(dplyr)
# BD000 : diagnostic du déséquilibre résiduel
cat("=== BD000 : composantes ressources vs emplois (2021) ===\n")
cat("Ressources annuelles 2021 :\n")
ere_ressources_completes |>
filter(Code_Produit == "BD000", annee == 2021) |>
group_by(composante) |>
summarise(valeur = sum(valeur_composante)) |>
filter(abs(valeur) > 0.1) |> print()
cat("\nEmplois annuels 2021 :\n")
emplois_ere_complets |>
filter(Code_Produit == "BD000", annee == 2021) |>
group_by(composante) |>
summarise(valeur = sum(valeur_cal)) |>
filter(abs(valeur) > 0.1) |> print()
cat("\nCI CNA cible 2021 vs CI benchmarkée :\n")
cat("CNA :", cna_ere_struct[["CI Prix d'acquisition"]]$CnaErECrt |>
filter(annee == 2021) |> pull(BD000), "\n")
cat("Bench:", p2_ere_crt |> filter(Code_Produit == "BD000", annee == 2021) |>
summarise(s = sum(P2_crt)) |> pull(s) |> round(), "\n")
# Bilan CNA complet BD000 2021
cat("=== BD000 — toutes composantes CNA 2021 ===\n")
lapply(names(cna_ere_struct), function(comp) {
df <- cna_ere_struct[[comp]]$CnaErECrt
if (!is.data.frame(df) || !"BD000" %in% names(df)) return(NULL)
val <- df |> filter(annee == 2021) |> pull("BD000")
if (length(val) > 0 && !is.na(val) && abs(val) > 0)
tibble(composante = comp, valeur_cna = val)
}) |> bind_rows() |> arrange(desc(abs(valeur_cna))) |> print()
cat("\nBilan CNA BD000 2021 :\n")
all_comps <- lapply(names(cna_ere_struct), function(comp) {
df <- cna_ere_struct[[comp]]$CnaErECrt
if (!is.data.frame(df) || !"BD000" %in% names(df)) return(NULL)
val <- df |> filter(annee == 2021) |> pull("BD000")
if (length(val) > 0 && !is.na(val)) tibble(composante = comp, valeur_cna = val)
}) |> bind_rows()
cat("Total ressources CNA :", all_comps |> filter(composante %in% c("PRODUCTION","IMPORTATIONS","IMPOT sur Import","IMPOT sur export","MARGE de commerce","MARGE de transport","TVA Non Déductible","IMPOT sur produit","Subventions sur produits")) |> pull(valeur_cna) |> sum(), "\n")
cat("Total emplois CNA    :", all_comps |> filter(!composante %in% c("PRODUCTION","IMPORTATIONS","IMPOT sur Import","IMPOT sur export","MARGE de commerce","MARGE de transport","TVA Non Déductible","IMPOT sur produit","Subventions sur produits")) |> pull(valeur_cna) |> sum(), "\n")
# Vérifier que PRODUCTION CNA est disponible et vérifier BD000, EZ000
prod_cna_crt <- cna_ere_struct[["PRODUCTION"]]$CnaErECrt
cat("PRODUCTION CNA dim :", paste(dim(prod_cna_crt), collapse="×"), "\n\n")
cat("Comparaison p1_ere_crt vs CNA PRODUCTION (2021) :\n")
p1_ere_crt |>
filter(annee == 2021) |>
group_by(Code_Produit) |>
summarise(p1_trim = sum(P1_crt), .groups = "drop") |>
left_join(
prod_cna_crt |> filter(annee == 2021) |>
tidyr::pivot_longer(-annee, names_to = "Code_Produit", values_to = "p1_cna"),
by = "Code_Produit"
) |>
mutate(ecart_pct = round((p1_trim - p1_cna) / p1_cna * 100, 1)) |>
filter(abs(ecart_pct) > 1) |>
arrange(desc(abs(ecart_pct))) |>
print()
devtools::load_all("C:/CnaBfaScn08/CntBfaV4/07P_Outils/QnaSut")
p1_final       <- calculer_p1_ere(p1_agreg_complet, res_trim$poids_trim, Map_Produits)
p1_par_produit <- p1_final$p1_par_produit
p1_ere_bench   <- benchmarker_p1_ere(p1_final$p1_ere_crt, p1_final$p1_ere_vol, cna_ere_struct)
p1_ere_crt     <- p1_ere_bench$p1_ere_crt
p1_ere_vol     <- p1_ere_bench$p1_ere_vol
p2_ere        <- calculer_p2_ere(p2_par_produit_n3, Map_Produits)
p2_ere_bench  <- benchmarker_p2_ere(p2_ere$p2_ere_crt, p2_ere$p2_ere_vol, cna_ere_struct)
p2_ere_crt    <- p2_ere_bench$p2_ere_crt
p2_ere_vol    <- p2_ere_bench$p2_ere_vol
ere_res <- executer_ressources_ere(
p1_ere_crt = p1_ere_crt, p1_ere_vol = p1_ere_vol, cnt_imp_final = cnt_imp_final,
cna_ere_struct = cna_ere_struct, derniere_annee_cna = derniere_annee_definitif,
annee_fin_proj = annee_fin_projection
)
ere_ressources_completes      <- ere_res$ressources_crt
ere_ressources_vpap_completes <- ere_res$ressources_vpap
ere_ressources_chaine         <- ere_res$ressources_chaine
ere_emp <- executer_emplois_ere(
ere_res = ere_res, p2_ere_crt = p2_ere_crt, p2_ere_vol = p2_ere_vol,
cnt_exp_final = cnt_exp_final, p1_ere_crt = p1_ere_crt, p1_ere_vol = p1_ere_vol,
cna_ere_struct = cna_ere_struct, path_methode_ere = path_methode_ere,
map_feuille_cna = map_feuille_cna, map_apu_cols = map_apu_cols,
ind_crt = ind_crt, ind_cst = ind_cst
)
emplois_ere_complets <- ere_emp$emplois_crt
emplois_ere_vol      <- ere_emp$emplois_vol
emplois_ere_vpap     <- ere_emp$emplois_vpap
total_res <- ere_ressources_completes |>
group_by(annee, trimestre, Code_Produit) |>
summarise(total_ressources = sum(valeur_composante, na.rm = TRUE), .groups = "drop")
total_emp <- emplois_ere_complets |>
group_by(annee, trimestre, Code_Produit) |>
summarise(total_emplois = sum(valeur_cal, na.rm = TRUE), .groups = "drop")
equilibre <- total_res |>
inner_join(total_emp, by = c("annee", "trimestre", "Code_Produit")) |>
mutate(solde = total_ressources - total_emplois,
solde_pct = ifelse(total_ressources > 0, solde / total_ressources * 100, NA_real_))
library(dplyr)
annee_cna <- derniere_annee_definitif
bilan_annuel <- equilibre |>
group_by(Code_Produit, annee) |>
summarise(res = sum(total_ressources), emp = sum(total_emplois),
solde = sum(solde), .groups = "drop") |>
filter(res > 0 | emp > 0) |>
mutate(solde_pct = round(solde / pmax(res, 1) * 100, 3),
periode   = if_else(annee <= annee_cna, "CNA", "Projection"))
bilan_cna <- bilan_annuel |> filter(periode == "CNA")
cat("=== BLOC 1 : Égalité annuelle sur les années CNA ===\n")
cat("|solde| < 1     :", sum(abs(bilan_cna$solde) < 1),   "/", nrow(bilan_cna), "lignes\n")
cat("|solde| < 100   :", sum(abs(bilan_cna$solde) < 100), "/", nrow(bilan_cna), "lignes\n")
cat("|solde| < 1000  :", sum(abs(bilan_cna$solde) < 1000),"/", nrow(bilan_cna), "lignes\n\n")
cat("Déséquilibres résiduels (|solde_pct| > 1%) :\n")
bilan_cna |>
filter(abs(solde_pct) > 1) |>
arrange(desc(abs(solde_pct))) |>
select(Code_Produit, annee, res, emp, solde, solde_pct) |>
print(n = 20)
cat("\n=== BLOC 2 : Années de projection — amplitude des écarts ===\n")
bilan_annuel |>
filter(periode == "Projection") |>
group_by(Code_Produit) |>
summarise(s_moy = round(mean(solde_pct), 1),
s_max = round(max(abs(solde_pct)), 1), .groups = "drop") |>
filter(abs(s_moy) > 3) |>
arrange(desc(abs(s_moy))) |>
print()
