# Concatène tous les fichiers .R en un seul bloc copiable
fichiers <- list.files("R/", pattern = "\\.R$", full.names = TRUE)
for (f in fichiers) {
cat("\n\n", paste(rep("=", 60), collapse=""), "\n")
cat("### FICHIER :", basename(f), "\n")
cat(paste(rep("=", 60), collapse=""), "\n\n")
cat(readLines(f, warn = FALSE), sep = "\n")
}
