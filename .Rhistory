dplyr::filter(.data$Code_Produit == code_produit) |>
dplyr::group_by(.data$annee, .data$trimestre) |>
dplyr::summarise(v = sum(.data$valeur, na.rm = TRUE), .groups = "drop") |>
dplyr::group_by(.data$annee) |>
dplyr::mutate(tot  = sum(.data$v),
part = dplyr::if_else(.data$tot == 0, 0.25, .data$v / .data$tot)) |>
dplyr::ungroup() |>
dplyr::select(.data$annee, .data$trimestre, .data$part)
}, error = function(e) tibble::tibble())
}
# Annuel → trimestriel via profil
.annuel_vers_trim <- function(tbl_ann, profil) {
if (nrow(profil) == 0) {
# Profil plat si pas de données imports
annees <- unique(tbl_ann$annee)
profil <- tidyr::expand_grid(annee = annees, trimestre = 1:4) |>
dplyr::mutate(part = 0.25)
}
dplyr::left_join(tbl_ann, profil, by = "annee") |>
dplyr::mutate(
part        = dplyr::if_else(is.na(.data$part), 0.25, .data$part),
valeur_trim = .data$valeur_annuelle * .data$part
)
}
# Construire le bloc data_produit pour un produit et une liste de composantes
.build_bloc <- function(composantes, code_produit, profil, type_bloc) {
purrr::map_dfr(composantes, function(comp) {
ann <- .extraire_cna_annuel(comp, code_produit)
if (nrow(ann) == 0) return(tibble::tibble())
if (all(ann$valeur_annuelle == 0, na.rm = TRUE) && type_bloc == "emploi")
return(tibble::tibble())
.annuel_vers_trim(ann, profil) |>
dplyr::transmute(
Code_Produit         = code_produit,
annee                = .data$annee,
trimestre            = .data$trimestre,
composante           = comp,
valeur_trimestrielle = .data$valeur_trim,
valeur_annuelle      = .data$valeur_annuelle,
type_bloc            = type_bloc
)
})
}
# ============================================================
# Construction data_ere pour tous les produits du modele
# ============================================================
codes_produits <- unique(model_equil$Code_Produit)
cat("Produits a traiter :", length(codes_produits), "\n")
# Composantes ressources et emplois figés standards
COMP_RESSOURCES <- c("PRODUCTION", "IMPORTATIONS")
# Les composantes figées = toutes les composantes ERE emplois
# sauf celles ajustables pour ce produit (gérées par modele)
COMP_EMPLOIS_STD <- c(
"CI Prix d'acquisition",
"CF Marchande Menage Prix d'acquisition",
"CF Non Marchande Menage Prix d'acquisition",
"CF Non Marchande APU Prix d'acquisition",
"CF Non Marchande ISBL Prix d'acquisition",
"FBCF Prix d'acquisition",
"VS Prix d'acquisition",
"Exportation Prix d'acquisition"
)
data_ere <- purrr::map_dfr(codes_produits, function(code) {
comp_aj <- model_equil |>
dplyr::filter(.data$Code_Produit == code) |>
dplyr::pull(.data$composante_ajustable)
comp_figes <- setdiff(COMP_EMPLOIS_STD, comp_aj)
profil <- .profil_imports(code)
res  <- .build_bloc(COMP_RESSOURCES, code, profil, "ressource")
emp_figes <- .build_bloc(comp_figes,  code, profil, "emploi")
emp_aj    <- .build_bloc(comp_aj,     code, profil, "emploi")
if (nrow(emp_aj) == 0) return(tibble::tibble())  # produit sans données CNA
dplyr::bind_rows(res, emp_figes, emp_aj)
})
cat("data_ere :", nrow(data_ere), "lignes |",
dplyr::n_distinct(data_ere$Code_Produit), "produits\n")
resultats <- QnaSut::equilibrer_ere_multivarie(
data_ere       = data_ere,
model_equil    = model_equil,
tol_recentrage = TOL_RECENTRAGE
)
cat("Produits traites :", length(resultats), "\n")
synthese <- purrr::imap_dfr(resultats, function(res, code) {
tibble::tibble(
Code_Produit        = code,
methode             = res$methode %||% "inconnu",
recentrage          = isTRUE(res$diagnostic$recentrage_applique),
n_comp_aj           = length(res$diagnostic$composantes_ajustables %||% character(0)),
echec               = res$methode %in% c("echec", "erreur"),
raison_echec        = if (res$methode %in% c("echec", "erreur"))
res$diagnostic$raison_echec %||% NA_character_ else NA_character_,
ecart_annuel_max    = if (nrow(res$series_ajustees) > 0 &&
!is.null(res$diagnostic$controle_annuel))
max(abs(res$diagnostic$controle_annuel$ecart_annuel), na.rm = TRUE)
else NA_real_,
ecart_contemp_max   = if (nrow(res$series_ajustees) > 0 &&
!is.null(res$diagnostic$controle_contemporain))
max(abs(res$diagnostic$controle_contemporain$ecart_contemporain), na.rm = TRUE)
else NA_real_
)
})
# Opérateur null-coalescing
`%||%` <- function(a, b) if (!is.null(a)) a else b
safe_kable(synthese, "Synthese de l'equilibrage par produit")
echecs <- dplyr::filter(synthese, echec)
if (nrow(echecs) > 0) {
cat("\n⚠️ Produits en echec :", nrow(echecs), "\n")
safe_kable(echecs |> dplyr::select(Code_Produit, methode, raison_echec),
"Produits en echec — raisons")
} else {
cat("\n✅ Tous les produits ont ete equilibres avec succes.\n")
}
for (code in names(resultats)) {
res <- resultats[[code]]
cat("\n---\n")
cat("## Produit :", code, "\n\n")
# Methode utilisee
cat("**Méthode :**", res$methode, "\n\n")
# Cas echec
if (res$methode %in% c("echec", "erreur")) {
cat("> ❌ Equilibrage non realise.\n")
cat("> **Raison :**", res$diagnostic$raison_echec %||% "inconnue", "\n\n")
next
}
# ---- Déséquilibre trimestriel par année ----
cat("### Vérification cohérence annuelle des déséquilibres\n\n")
if (!is.null(res$diagnostic$table_contrainte)) {
verif_deseq <- res$diagnostic$table_contrainte |>
dplyr::group_by(.data$annee) |>
dplyr::summarise(
somme_ecarts_bruts    = round(sum(.data$contrainte_initiale, na.rm = TRUE), 4),
somme_ecarts_recales  = round(sum(.data$contrainte_contemp,  na.rm = TRUE), 4),
offset_applique       = round(dplyr::first(.data$offset), 6),
coherent              = abs(sum(.data$contrainte_contemp, na.rm = TRUE)) < 0.01,
.groups = "drop"
)
print(knitr::kable(verif_deseq,
caption = paste(code, "— Cohérence annuelle des déséquilibres")))
cat("\n")
}
# ---- Composantes ajustées ----
cat("### Composantes ajustées : avant / après / écart\n\n")
if (nrow(res$series_ajustees) > 0) {
print(knitr::kable(
res$series_ajustees |>
dplyr::mutate(
valeur_avant = round(.data$valeur_avant, 2),
valeur_apres = round(.data$valeur_apres, 2),
delta        = round(.data$delta, 2)
),
caption = paste(code, "— Séries ajustées")
))
cat("\n")
# ---- Contrôle annuel ----
cat("### Contrôle annuel (somme trim vs cible CNA)\n\n")
if (!is.null(res$diagnostic$controle_annuel)) {
print(knitr::kable(
res$diagnostic$controle_annuel |>
dplyr::mutate(
somme_apres  = round(.data$somme_apres, 2),
valeur_annuelle = round(.data$valeur_annuelle, 2),
ecart_annuel = round(.data$ecart_annuel, 4)
),
caption = paste(code, "— Contrôle annuel")
))
cat("\n")
}
# ---- Contrôle contemporain ----
cat("### Contrôle contemporain (somme ajustables vs contrainte)\n\n")
if (!is.null(res$diagnostic$controle_contemporain)) {
print(knitr::kable(
res$diagnostic$controle_contemporain |>
dplyr::mutate(
somme_aj            = round(.data$somme_aj, 2),
contrainte_contemp  = round(.data$contrainte_contemp, 2),
ecart_contemporain  = round(.data$ecart_contemporain, 4)
),
caption = paste(code, "— Contrôle contemporain")
))
cat("\n")
}
}
}
path_export <- file.path(
root_dir,
paste0("Equilibrage_ERE_Tous_Produits_", format(Sys.Date(), "%Y%m%d"), ".xlsx")
)
# ---- Feuille synthese ----
sheets <- list(
Synthese = synthese
)
# ---- Feuille par produit ----
for (code in names(resultats)) {
res <- resultats[[code]]
if (res$methode %in% c("echec", "erreur")) next
if (nrow(res$series_ajustees) == 0) next
# Déséquilibre trimestriel
deseq <- res$diagnostic$table_contrainte |>
dplyr::select(.data$annee, .data$trimestre,
desequilibre_brut   = .data$contrainte_initiale,
desequilibre_recale = .data$contrainte_contemp,
offset              = .data$offset) |>
dplyr::mutate(Code_Produit = code, .before = 1)
# Séries ajustées
aj <- res$series_ajustees |>
dplyr::mutate(methode = res$methode)
# Contrôle annuel
ctrl_ann <- if (!is.null(res$diagnostic$controle_annuel))
dplyr::mutate(res$diagnostic$controle_annuel, Code_Produit = code, .before = 1)
else tibble::tibble()
# Noms de feuilles limités à 31 caractères (contrainte Excel)
nm_deseq   <- paste0(substr(code, 1, 20), "_deseq")
nm_ajust   <- paste0(substr(code, 1, 20), "_ajust")
nm_ctrl    <- paste0(substr(code, 1, 20), "_ctrl")
sheets[[nm_deseq]] <- deseq
sheets[[nm_ajust]] <- aj
if (nrow(ctrl_ann) > 0) sheets[[nm_ctrl]] <- ctrl_ann
}
writexl::write_xlsx(sheets, path = path_export)
cat("Export Excel :", path_export, "\n")
View(modele_equilibrage)
View(data_ere)
View(modele_equilibrage)
?charger_donnees_cnt
View(data_ere)
devtools::document()
load()
devtools::install()
# ==============================================================================
