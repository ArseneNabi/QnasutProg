nrow(modele_equilibrage_ere$produits_modeles), " produits | ",
nrow(modele_equilibrage_ere$modeles_composantes), " modeles"
)
# Execution de l'equilibrage pour tous les produits du modele
# -- Prix courants : ressources_crt + emplois_crt, cibles CnaErECrt
# -- VPAP          : ressources_vpap + emplois_vpap, cibles CnaErEVol
# Aucune distribution d'annuels en trimestriels : les donnees
